generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // troque para "postgresql" em produção
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  appleId       String?  @unique
  avatarUrl     String?
  onboarded     Boolean  @default(false)
  monthlyIncome Float    @default(0)
  goal          String   @default("organize")
  hasDebts      Boolean  @default(false)
  createdAt     DateTime @default(now())

  accounts     Account[]
  creditCards  CreditCard[]
  transactions Transaction[]
  categories   Category[]
  recurring    RecurringTransaction[]
  debts        Debt[]
  goals        FinancialGoal[]
}

model Account {
  id             String   @id @default(cuid())
  userId         String
  name           String
  institution    String
  type           String
  initialBalance Float    @default(0)
  color          String
  icon           String
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model CreditCard {
  id             String   @id @default(cuid())
  userId         String
  name           String
  institution    String
  limit          Float
  closingDay     Int
  dueDay         Int
  color          String
  lastFourDigits String?
  createdAt      DateTime @default(now())

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices CreditCardInvoice[]
  @@index([userId])
}

model CreditCardInvoice {
  id                String    @id @default(cuid())
  creditCardId      String
  referenceMonth    String // YYYY-MM
  closingDate       DateTime
  dueDate           DateTime
  status            String    @default("open") // open | closed | paid
  paidWithAccountId String?
  paidAt            DateTime?

  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  @@unique([creditCardId, referenceMonth])
}

model Category {
  id        String  @id @default(cuid())
  userId    String?
  name      String
  icon      String
  color     String
  type      String // income | expense
  isDefault Boolean @default(false)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                 String   @id @default(cuid())
  userId             String
  type               String // income | expense | transfer
  amount             Float
  description        String
  categoryId         String?
  date               DateTime
  status             String   @default("paid") // paid | pending
  paymentMethod      String   @default("account")
  accountId          String?
  toAccountId        String?
  creditCardId       String?
  invoiceId          String?
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  recurringId        String?
  note               String?
  createdAt          DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice CreditCardInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  @@index([userId, date])
  @@index([invoiceId])
}

model RecurringTransaction {
  id            String    @id @default(cuid())
  userId        String
  description   String
  amount        Float
  type          String
  categoryId    String?
  dueDay        Int
  frequency     String    @default("monthly")
  paymentMethod String    @default("account")
  accountId     String?
  creditCardId  String?
  startDate     DateTime
  endDate       DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Debt {
  id                String   @id @default(cuid())
  userId            String
  name              String
  creditor          String
  totalAmount       Float
  remainingAmount   Float
  interestRate      Float?
  installmentsTotal Int
  installmentAmount Float
  dueDate           DateTime
  priority          String   @default("medium")
  status            String   @default("open")
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model FinancialGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  accountId     String?
  icon          String    @default("flag")
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
