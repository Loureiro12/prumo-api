# SQLite para desenvolvimento; troque por postgresql://... em produção
DATABASE_URL="file:./dev.db"
JWT_SECRET="troque-este-segredo"
PORT=3333

# Login social — preencha quando tiver as credenciais reais.
# Google Cloud Console > Credentials: client IDs de iOS, Android e Web,
# separados por vírgula (o backend aceita id_token emitido pra qualquer um).
GOOGLE_CLIENT_IDS=""
# Apple Developer > Sign In with Apple: bundle id (app nativo) ou Services ID.
APPLE_CLIENT_ID=""
